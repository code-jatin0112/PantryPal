# ==============================================================================
# PantryPal Backend Environment Configuration
# ==============================================================================

# Server Environment
# Set to 'production' for live deployments
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL - Production & Development)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In Railway: Provided automatically by Railway PostgreSQL plugin via ${{DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pantrypal?schema=public

# Database Connection (MongoDB - NoSQL for AI Telemetry & Unstructured Recipes)
# Format: mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
# In Railway: Connect to MongoDB Atlas or Railway MongoDB template
MONGO_URI=mongodb://localhost:27017/pantrypal_ai

# Authentication & Security
# Generate in terminal: openssl rand -hex 32 (Must be >= 32 characters in production)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed browser client origins (NO trailing slashes)
# In production: https://pantrypal.vercel.app,https://yourcustomdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Reverse Proxy / Load Balancer Configuration
# Set to 'true' in Railway, Render, Fly.io, Cloudflare, or AWS ALB deployments
TRUST_PROXY=true

# API Rate Limiting (In-Memory / Process-Local)
# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_MAX_REQUESTS: Max allowed requests per IP per window (default: 500)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Authentication Rate Limiting
# AUTH_RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 900000 = 15 minutes)
# AUTH_RATE_LIMIT_MAX_REQUESTS: Max login/register attempts per IP per window (default: 10)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# AI Generation Rate Limiting
# AI_RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 900000 = 15 minutes)
# AI_RATE_LIMIT_MAX_REQUESTS: Max AI requests per user/IP per window (default: 20)
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=20

# AI & LLM Integration (Google Gemini via @google/genai)
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30000

# ------------------------------------------------------------------------------
# TEST-ONLY DATABASES (DO NOT SET IN PRODUCTION ENVIRONMENTS)
# These variables are strictly required when NODE_ENV=test and guarded by testDatabaseGuard.js
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pantrypal_test?schema=public
MONGO_TEST_URI=mongodb://localhost:27017/pantrypal_test
